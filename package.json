{
  "name": "nc-manager",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:emulator": "turbo run test:emulator",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "build:packages": "pnpm --filter @nc-manager/shared-types build && pnpm --filter @nc-manager/shared-constants build && pnpm --filter @nc-manager/validation build",
    "emulator": "pnpm run build:packages && pnpm --filter @nc-manager/functions build && firebase emulators:start",
    "seed": "node scripts/seed-emulator.mjs"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "firebase-admin": "^13.4.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.1.0"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
