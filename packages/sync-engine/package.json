{
  "name": "@nc-manager/sync-engine",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nc-manager/shared-types": "workspace:*",
    "@nc-manager/shared-constants": "workspace:*"
  },
  "devDependencies": {
    "@nc-manager/tsconfig": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1",
    "rimraf": "^6.0.1"
  },
  "peerDependencies": {
    "react-native-mmkv": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  }
}
