{
  "name": "@nc-manager/functions",
  "version": "0.0.1",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "clean": "rimraf lib"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.6.0",
    "@nc-manager/shared-types": "workspace:*",
    "@nc-manager/validation": "workspace:*",
    "@nc-manager/shared-constants": "workspace:*",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@nc-manager/tsconfig": "workspace:*",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1",
    "rimraf": "^6.0.1",
    "@types/node": "^22.15.21"
  }
}
